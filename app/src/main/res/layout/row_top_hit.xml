<?xml version="1.0" encoding="utf-8"?>
<!-- Eine Zeile der Trefferliste. Die Marke faerbt sich nach dem Urteil. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_min_height"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/topRank"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:textColor="@color/ink3"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="1" />

    <TextView
        android:id="@+id/topLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/ink"
        android:textSize="14sp"
        tools:text="Stadt-Champignon — 73 %" />

    <TextView
        android:id="@+id/topMark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="☠" />
</LinearLayout>
