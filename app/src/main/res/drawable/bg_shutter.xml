<?xml version="1.0" encoding="utf-8"?>
<!--
    Der Sammelring: neutrale Papiermarke mit Tintenring.

    Bewusst kein gruen gefuellter "Go"-Knopf. Gruen in dieser App bedeutet
    ausschliesslich "diese Bildansicht wurde ausreichend erfasst"; der
    Ausloeser selbst darf keine Freigabeoptik tragen (Spec 2026-09-24,
    Abschnitt "Sichtbare Fuehrung").
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ink" />
        </shape>
    </item>
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="@color/paper" />
        </shape>
    </item>
    <item
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp">
        <shape android:shape="oval">
            <stroke
                android:width="3dp"
                android:color="@color/ink" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
