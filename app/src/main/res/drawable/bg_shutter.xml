<?xml version="1.0" encoding="utf-8"?>
<!-- Runder Ausloeser: Waldgruen, innen ein weisser Ring als Zielmarke. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/forest" />
        </shape>
    </item>
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <stroke
                android:width="3dp"
                android:color="#F2FFFFFF" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item
        android:left="16dp"
        android:top="16dp"
        android:right="16dp"
        android:bottom="16dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item
        android:left="22dp"
        android:top="22dp"
        android:right="22dp"
        android:bottom="22dp">
        <shape android:shape="oval">
            <solid android:color="@color/forest" />
        </shape>
    </item>
</layer-list>
