<?xml version="1.0" encoding="utf-8"?>
<!--
    Eine der drei Ansichtszeilen im Live-Sucher.

    Der neutrale Ruhezustand: Papierflaeche, Tinte-Schrift. Erst wenn der
    ViewAccumulator eine belegte Ansicht akzeptiert hat, wird die Zeile gefuellt
    und nimmt die Moos-Marke an. Die einzige Bedeutung von Gruen hier ist
    "Ansicht ausreichend erfasst".
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/paper" />
    <corners android:radius="12dp" />
</shape>
