    <!-- Die drei belegbaren Ansichten des Mehransichten-Prototyps.

         Bewusst NICHT die unterste Stielzone benannt: die Datenquelle deckt die
         Volva nicht verlaesslich als eigene Klasse ab (Spec 2026-09-24). Ein gruener
         Haken bedeutet hier ausschliesslich "diese Bildansicht wurde
         ausreichend erfasst", also keine Bestimmung und keine Verzehrfreigabe. -->
    <string name="view_show_cap">Hut zeigen</string>
    <string name="view_show_underside">Unterseite zeigen</string>
    <string name="view_show_stipe_ring">Stiel / Ring zeigen</string>
